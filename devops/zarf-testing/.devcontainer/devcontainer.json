{
  "name": "coding-lab-control-plane",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "vscode",
  "workspaceFolder": "/workspaces/CodeLab-Hub/devops/zarf-testing",
  "runArgs": [
    "--init"
  ],
  "mounts": [
    "source=${localEnv:USERPROFILE}\\.kube,target=/home/vscode/.kube,type=bind,consistency=cached"
  ],
  "postCreateCommand": "pwsh -NoProfile -ExecutionPolicy Bypass -File /workspaces/CodeLab-Hub/devops/zarf-testing/safe-k8s.ps1 status",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      },
      "extensions": [
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "ms-vscode.powershell",
        "redhat.vscode-yaml",
        "vscjava.vscode-java-pack"
      ]
    }
  }
}

